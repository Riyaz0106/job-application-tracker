// Prisma schema for the Job Application Tracker.
// Docs: https://pris.ly/d/prisma-schema
//
// Prisma 6 (classic) setup:
//  - `prisma-client-js` generates the client into node_modules/.prisma/client,
//    re-exported by `@prisma/client` (import { PrismaClient } from '@prisma/client').
//  - The datasource url is read from process.env.DATABASE_URL; the Prisma CLI
//    auto-loads server/.env, and the running server loads it via src/config/env.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  applications Application[]
  createdAt    DateTime      @default(now())
}

model Application {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  company        String
  role           String
  jobDescription String      @db.Text
  matchScore     Int?
  matchGaps      String?     @db.Text

  // --- CV attachment (file lives in Cloudinary; only metadata is stored here) ---
  cvFileName   String?
  cvFileUrl    String?
  cvPublicId   String? // Cloudinary's destroy() takes a public_id, not a URL
  cvFileSize   Int? // bytes, for "filename and size" in the UI
  cvUploadedAt DateTime?

  // --- Cover-letter attachment ---
  // `coverLetter` stays the prose field (Phase 7 writes generated letter text
  // there), so the attachment needs its own filename column.
  coverLetter           String?
  coverLetterUrl        String?
  coverLetterFileName   String?
  coverLetterPublicId   String?
  coverLetterFileSize   Int?
  coverLetterUploadedAt DateTime?
  status         Status      @default(APPLIED)
  appliedDate    DateTime    @default(now())
  interviews     Interview[]
  salary         String?
  recruiter      String?
  notes          String?     @db.Text
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Interview {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  round         String
  date          DateTime
  notes         String?     @db.Text
}

enum Status {
  DRAFTING
  APPLIED
  PHONE_SCREEN
  TECHNICAL
  PANEL
  OFFER
  REJECTED
  ACCEPTED
}
